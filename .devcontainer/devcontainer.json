// See https://aka.ms/vscode-remote/devcontainer.json for format details.
{
  "name": "Home Assistant integration development",
  "image": "mcr.microsoft.com/devcontainers/python:3-3.14-trixie",
  // gh and Claude state lives in a named volume shared by all devcontainers, so
  // logins and sessions survive rebuilds. Docker creates it empty if missing.
  "mounts": [
    "source=ha-devcontainer-state,target=/home/vscode/.devcontainer-state,type=volume"
  ],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/vscode/.devcontainer-state/claude",
    "GH_CONFIG_DIR": "/home/vscode/.devcontainer-state/gh"
  },
  // A new volume is owned by root, so hand it all to vscode before anything writes to it
  "onCreateCommand": "sudo chown -R vscode:vscode /home/vscode/.devcontainer-state && mkdir -p /home/vscode/.devcontainer-state/claude /home/vscode/.devcontainer-state/gh && chmod 700 /home/vscode/.devcontainer-state/claude /home/vscode/.devcontainer-state/gh",
  "postCreateCommand": ".devcontainer/setup",
  "forwardPorts": [
    8123
  ],
  "portsAttributes": {
    "8123": {
      "label": "Home Assistant",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "charliermarsh.ruff",
        "esbenp.prettier-vscode",
        "github.vscode-pull-request-github",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ryanluker.vscode-coverage-gutters"
      ],
      "settings": {
        "files.eol": "\n",
        "editor.tabSize": 4,
        "python.analysis.autoSearchPaths": false,
        "editor.formatOnPaste": false,
        "editor.formatOnSave": true,
        "editor.formatOnType": true,
        "editor.codeActionsOnSave": {
          "source.organizeImports": "always"
        },
        "files.trimTrailingWhitespace": true,
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff"
        }
      }
    }
  },
  "remoteUser": "vscode",
  "features": {}
}
